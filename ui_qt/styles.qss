/* ========================================================================
   HOJA DE ESTILOS INSPIRADA EN MOONLIGHT QT - REFINAMIENTO SENSORIAL
   ======================================================================== */

QWidget {
    background-color: #212121;
    color: #ffffff;
    font-family: "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* Sidebar Izquierda */
QFrame#Sidebar {
    background-color: #171717;
    border-right: 1px solid #2d2d2d;
}

QLabel#SidebarTitle {
    color: #52a9ff;
    font-size: 14px;
    font-weight: bold;
    padding-top: 10px;
    padding-bottom: 12px;
    background: transparent;
}

QFrame#SidebarDivider {
    background-color: #2d2d2d;
    max-height: 1px;
    margin-bottom: 12px;
    margin-left: 16px;
}

QLabel#SidebarSectionLabel {
    color: #64748b;
    font-size: 10px;
    font-weight: bold;
    padding-top: 20px;
    padding-bottom: 6px;
    padding-left: 20px;
    background: transparent;
}

/* Botones del Sidebar (Refinados con pestaña indicadora interactiva) */
QPushButton#SidebarButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-left: 3px solid transparent; /* Indicador oculto por defecto */
    border-radius: 0px 6px 6px 0px; /* Bordes redondeados solo a la derecha */
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px; /* Aire izquierdo para el icono */
    text-align: left;
    min-height: 20px;
}

QPushButton#SidebarButton:hover {
    background-color: #1e202f; /* Fondo ligeramente azulado al pasar el mouse */
    color: #52a9ff;
    border-left: 3px solid #52a9ff; /* Muestra el indicador vertical cian */
}

QPushButton#SidebarButton:pressed {
    background-color: #111218;
}

QPushButton#SidebarLogoutButton {
    background-color: transparent;
    color: #ef4444;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px 6px 6px 0px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    text-align: left;
    font-weight: bold;
    min-height: 20px;
    margin-top: 8px;
}

QPushButton#SidebarLogoutButton:hover {
    background-color: #2d1717;
    border-left: 3px solid #ef4444;
}

/* Topbar (Fuerza la transparencia absoluta eliminando los cuadros negros) */
QFrame#Topbar {
    background-color: #3b4cb4;
    border: none;
}

QFrame#Topbar QLabel {
    background-color: transparent;
    background: transparent;
    border: none;
}

QLabel#TopbarTitle {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#TopbarSession {
    color: #cbd5e1;
    font-size: 12px;
    font-weight: bold;
}

/* Área de Trabajo y Tarjetas */
QFrame#AreaTrabajo {
    background-color: #212121;
}

QLabel#DashboardTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}

QLabel#DashboardSub {
    color: #a1a1a8;
    font-size: 13px;
    padding-bottom: 8px;
}

QFrame#Card {
    background-color: #2d2d2d;
    border: 1px solid #3e3e3e;
    border-radius: 8px;
}

QLabel#CardTitle {
    color: #52a9ff;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#CardBody {
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 13px;
    background-color: transparent;
}
