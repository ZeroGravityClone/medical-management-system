/* ========================================================================
   HOJA DE ESTILOS INSPIRADA EN MOONLIGHT QT - REFINAMIENTO DE LAYOUT
   ======================================================================== */

QWidget {
    background-color: #212121;
    color: #ffffff;
    font-family: "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* Sidebar Izquierda */
QFrame#Sidebar {
    background-color: #171717;
    border-right: 1px solid #2d2d2d;
}

QLabel#SidebarTitle {
    color: #52a9ff;
    font-size: 16px;
    font-weight: bold;
    padding-top: 8px;
    padding-bottom: 12px;
}

QFrame#SidebarDivider {
    background-color: #2d2d2d;
    max-height: 1px;
    margin-bottom: 12px;
}

QLabel#SidebarSectionLabel {
    color: #7d7d7d;
    font-size: 11px;
    font-weight: bold;
    padding-top: 20px;
    padding-bottom: 4px;
    padding-left: 12px;
}

/* Botones del Sidebar (Refinados con paddings y tamaños estándar) */
QPushButton#SidebarButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 6px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px; /* Desplazamiento controlado por CSS */
    text-align: left;
    min-height: 20px;
}

QPushButton#SidebarButton:hover {
    background-color: #2d2d2d;
    color: #52a9ff;
}

QPushButton#SidebarButton:pressed {
    background-color: #1a1a1a;
}

QPushButton#SidebarLogoutButton {
    background-color: transparent;
    color: #ef4444;
    border: none;
    border-radius: 6px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    text-align: left;
    font-weight: bold;
    min-height: 20px;
    margin-top: 8px;
}

QPushButton#SidebarLogoutButton:hover {
    background-color: #2d1717;
}

/* Topbar (Refinado con alineación geométrica exacta) */
QFrame#Topbar {
    background-color: #3b4cb4;
    border: none;
}

QLabel#TopbarTitle {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#TopbarSession {
    color: #cbd5e1;
    font-size: 12px;
    font-weight: bold;
}

/* Área de Trabajo y Tarjetas */
QFrame#AreaTrabajo {
    background-color: #212121;
}

QLabel#DashboardTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}

QLabel#DashboardSub {
    color: #a1a1a8;
    font-size: 13px;
    padding-bottom: 8px;
}

/* Cards (Padding uniforme garantizado) */
QFrame#Card {
    background-color: #2d2d2d;
    border: 1px solid #3e3e3e;
    border-radius: 8px;
}

QLabel#CardTitle {
    color: #52a9ff;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent; /* Corregido fondo oscuro bajo el título */
}

QLabel#CardBody {
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 13px;
    background-color: transparent;
}